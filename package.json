{
  "name": "wego-business-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "npx tsx scripts/seed.ts",
    "verify:firebase": "npx tsx scripts/verify-firebase.ts",
    "test:payments": "npx tsx src/lib/finance/payments.test.ts",
    "test:project-ledger": "npx tsx src/lib/finance/project-ledger.test.ts",
    "test:timestamps": "npx tsx src/lib/dates/timestamp.test.ts",
    "test:legacy-dates": "npx tsx src/lib/dates/legacy.test.ts",
    "test:date-picker": "npx tsx src/lib/dates/date-picker-model.test.ts",
    "import:legacy": "npx tsx scripts/import-legacy-wego-data.ts",
    "import:legacy:dry": "npx tsx scripts/import-legacy-wego-data.ts --dry-run",
    "test:category-colors": "npx tsx src/lib/admin/category-color.test.ts",
    "test:permissions": "npx tsx src/lib/permissions/engine.test.ts",
    "test:project-access": "npx tsx src/lib/permissions/project-access.test.ts",
    "test:meeting-access": "npx tsx src/lib/permissions/meeting-access.test.ts",
    "test:cron-auth": "npx tsx src/lib/auth/cron-auth.test.ts",
    "test:task-status-read": "npx tsx src/lib/admin/task-status-read.test.ts",
    "test:task-library": "npx tsx src/lib/admin/task-library.test.ts",
    "test:task-delete": "npx tsx src/lib/admin/task-delete.test.ts",
    "test:task-participants": "npx tsx src/lib/admin/task-participants.test.ts",
    "test:task-completion": "npx tsx src/lib/admin/task-completion.test.ts",
    "test:department-categories": "npx tsx src/lib/admin/department-categories.test.ts",
    "test:task-file-rules": "npx tsx src/lib/admin/task-file-rules.test.ts",
    "test:project-system": "npx tsx src/lib/admin/project-system-rules.test.ts",
    "test:project-system-form": "npx tsx src/lib/admin/project-system-form-state.test.ts",
    "test:project-credentials-crypto": "npx tsx src/lib/security/project-credentials-crypto.test.ts",
    "test:project-credentials-access": "npx tsx src/lib/admin/project-credentials-access.test.ts",
    "test:project-credential-actions": "npx tsx src/lib/admin/project-credential-actions.test.ts",
    "test:project-credentials": "npm run test:project-credentials-crypto && npm run test:project-credentials-access && npm run test:project-credential-actions && npm run test:project-system",
    "test:finance-orphan": "npx tsx src/lib/finance/orphan.test.ts",
    "test:document-totals": "npx tsx src/lib/docs/totals.test.ts",
    "test:business-profile": "npx tsx src/lib/data/business-profile.test.ts",
    "test:records-access": "npx tsx src/lib/permissions/records-access.regression.test.ts",
    "test:phase1-security": "npm run test:cron-auth && npm run test:meeting-access && npm run test:project-access && npm run test:task-status-read && npm run test:records-access && npm run test:permissions",
    "inventory:reset-dry-run": "npx tsx scripts/inventory-reset-dry-run.ts",
    "verify:settings-control": "npx tsx scripts/verify-settings-control.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "jose": "4.15.9"
  }
}
